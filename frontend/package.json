{
  "name": "pgray",
  "appId": "com.pgray.app",
  "productName": "PGRay",
  "private": true,
  "version": "0.1.0",
  "description": "Postgres Query Visualizer & Local AI IDE",
  "author": {
    "name": "PGRay",
    "email": "noreply@pgray.app"
  },
  "homepage": "https://github.com/rajeshkumarblr/pgray",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.pgray.app",
    "productName": "PGRay",
    "copyright": "Copyright © 2026",
    "icon": "public/pgray_256.png",
    "asar": true,
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "pgray-backend",
          "pgray-backend.exe",
          "saved_queries/**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/pgray_256.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "type": "distribution"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@types/diff": "^7.0.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "axios": "^1.5.0",
    "dagre": "^0.8.5",
    "diff": "^8.0.3",
    "framer-motion": "^12.32.0",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-syntax-highlighter": "^16.1.0",
    "reactflow": "^11.8.3",
    "recharts": "^3.7.0",
    "sql-formatter": "^15.6.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/dagre": "^0.7.53",
    "@types/node": "^25.0.10",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
